; Engine configuration file.
config_version=5

[application]
config/name="첫 개미"
config/description="개미 한 마리를 직접 움직인다. 내가 걸은 자리에 냄새길이 남고, 군체의 개미들이 그 길을 따라 먹이를 나르고 싸운다."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Medium.ttf"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.067, 0.118, 1)
