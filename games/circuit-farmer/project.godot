; Engine configuration file.
config_version=5

[application]
config/name="떠돌이 밭"
config/description="겨울이 길을 따라 도는 고리 모양 길을 수레로 돌며, 지나는 땅마다 씨를 심고 떠났다가 익을 때 맞춰 돌아와 거두는 떠돌이 농사 게임."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Medium.ttf"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.067, 0.118, 1)
