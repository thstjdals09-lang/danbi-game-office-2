; Engine configuration file.
config_version=5

[application]
config/name="몸 하나로"
config/description="몸의 크기가 체력이자 탄약이자 열쇠인 슬라임 로그라이크"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Medium.ttf"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.067, 0.118, 1)
